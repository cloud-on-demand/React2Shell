# Local configuration (keep sanitized examples)
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# SSH identities and host records
.ssh/*
!.ssh/.gitkeep
id_rsa*
id_ed25519*
server_ed25519*
known_hosts*
*.pem
*.key
*.p12
*.pfx

# Dependencies and generated build output
node_modules/
.next/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local execution artifacts, recordings, and captured lab output
*.log
*.retry
/artifacts/
/recordings/
/captures/
*-artifact-*.json

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~


